{
  "name": "tevi-ocr",
  "version": "0.1.0",
  "description": "Laboratorio independiente para evaluación, mejora y validación OCR previa a integración con TEVI.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "test": "NODE_ENV=test node --import tsx --test tests/**/*.test.ts",
    "test:unit": "NODE_ENV=test node --import tsx --test tests/unit/**/*.test.ts",
    "test:integration": "NODE_ENV=test node --import tsx --test tests/integration/**/*.test.ts",
    "benchmark": "tsx benchmark/run.ts",
    "check": "npm run build && npm test && npm run test:camera-client",
    "benchmark:generate": "tsx scripts/generate-baseline-corpus.ts",
    "benchmark:baseline": "npm run benchmark:generate && tsx benchmark/run.ts",
    "test:camera-client": "node --test tests/browser/*.test.mjs",
    "benchmark:preprocessing": "tsx benchmark/preprocessing.ts",
    "benchmark:ocr-psm": "tsx benchmark/ocr-psm.ts",
    "benchmark:ocr-language-model": "tsx benchmark/ocr-language-model.ts",
    "benchmark:ocr-traineddata": "tsx benchmark/ocr-traineddata.ts",
    "benchmark:ocr-region-specialization": "tsx benchmark/ocr-region-specialization.ts",
    "benchmark:ocr-contextual-normalization": "tsx benchmark/ocr-contextual-normalization.ts",
    "validate:handwriting-corpus": "tsx scripts/validate-handwriting-corpus.ts",
    "benchmark:handwriting": "tsx benchmark/handwriting-baseline.ts",
    "benchmark:handwriting-preprocessing": "tsx benchmark/handwriting-preprocessing-matrix.ts",
    "benchmark:handwriting-final": "bash scripts/run-handwriting-final.sh",
    "benchmark:final": "tsx benchmark/final.ts",
    "benchmark:handwriting-performance": "bash scripts/run-handwriting-performance.sh",
    "benchmark:handwriting-v2-final": "tsx benchmark/handwriting-v2-final.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@tesseract.js-data/spa": "^1.0.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
